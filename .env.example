# ---------- Web (Vite) ----------
# Vite dev / preview server port (must be a positive integer)
PORT=5173
# Public base path for deployed assets (leading slash, trailing slash optional)
BASE_PATH=/

# ---------- API (Express) ----------
API_PORT=4000

# MongoDB Atlas connection string. Khali chhodoge to dev me in-memory Mongo chalega
# (data restart pe chala jayega). Production me zaroori hai.
MONGODB_URI=

# Admin login.
# On karne ke liye: ADMIN_AUTH=on, JWT_SECRET set karo (32+ random chars),
# aur `pnpm admin:create-user email password "Name"` chalao — YA pehli baar
# server start karte waqt ADMIN_EMAIL + ADMIN_PASSWORD set kar do, owner account
# apne aap ban jayega (password 10+ characters).
ADMIN_AUTH=off
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Agar site aur API alag domains pe hain to yahan site ka origin do (comma-separated)
CORS_ORIGINS=

# Uploads folder (images webp me convert hoke yahan jaati hain, PDFs as-is)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
